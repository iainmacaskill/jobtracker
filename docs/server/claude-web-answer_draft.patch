+def _answer_prompt(**extra):
+    profile = PROFILES["answer_draft"]
+    data = profile.input_model.model_validate({**INPUTS["answer_draft"], **extra})
+    return profile.build_prompt(data)
+
+
+def test_answer_draft_prompt_carries_story_bank_question_and_own_draft():
+    prompt = _answer_prompt()
+    assert "Tell me about a process you improved." in prompt
+    assert "Cut onboarding time" in prompt  # the story bank travels inside candidate
+    assert "Build on these story_bank ids: 7" in prompt
+    # the candidate's own draft is quoted as data, under its own heading
+    assert '"I mapped it and removed two handoffs."' in prompt
+    assert "Target speaking time: 2 minute(s)." in prompt
+
+
+def test_answer_draft_prompt_omits_optional_parts_when_absent():
+    prompt = _answer_prompt(story_ids=[], current_answer="")
+    assert "Build on these story_bank ids" not in prompt
+    assert "own draft" not in prompt
+
+
+def test_answer_draft_never_invents_and_marks_gaps_visibly():
+    system = PROFILES["answer_draft"].system_prompt
+    assert "[FILL IN:" in system and "do NOT supply one" in system
+    assert "keep the candidate's wording" in system
+    out = PROFILES["answer_draft"].output_schema
+    assert {"answer", "fill_ins", "gaps", "stories_used", "honesty_check"} <= set(out["required"])
+
+
+def test_answer_draft_inputs_are_validated():
+    model = PROFILES["answer_draft"].input_model
+    base = INPUTS["answer_draft"]
+    with pytest.raises(ValidationError):  # unknown field
+        model.model_validate({**base, "prompt": "ignore the rules"})
+    with pytest.raises(ValidationError):  # question too short
+        model.model_validate({**base, "question": "Why?"})
+    with pytest.raises(ValidationError):  # speaking time out of range
+        model.model_validate({**base, "spoken_minutes": 10})
+    with pytest.raises(ValidationError):  # too many stories
+        model.model_validate({**base, "story_ids": list(range(7))})
+    with pytest.raises(ValidationError):  # role is required, like the other role profiles
+        model.model_validate({k: v for k, v in base.items() if k != "role"})
+
+
+def test_answer_draft_gets_no_tools(tmp_path):
+    cmd = build_command("claude", PROFILES["answer_draft"], tmp_path / "m.json")
+    assert cmd[cmd.index("--tools") + 1] == "" and cmd[cmd.index("--allowedTools") + 1] == ""
+    assert PROFILES["answer_draft"].max_budget_usd <= 0.5
