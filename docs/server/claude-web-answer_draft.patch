+# --------------------------------------------------------------------------
+# answer_draft
+# --------------------------------------------------------------------------
+
+class AnswerDraftInput(_RoleInput):
+    question: str = Field(min_length=5, max_length=500, description="The interview question")
+    why_asked: str = Field(default="", max_length=500, description="What the interviewer is probing")
+    answer_outline: str = Field(default="", max_length=2000, description="An earlier outline, if any")
+    story_ids: List[int] = Field(
+        default_factory=list, max_length=6,
+        description="Ids from candidate.story_bank to build the answer on; empty: pick the best fit",
+    )
+    current_answer: str = Field(
+        default="", max_length=4000,
+        description="The candidate's own draft. Their wording and facts win; improve clarity only",
+    )
+    spoken_minutes: int = Field(default=2, ge=1, le=3, description="Target speaking time")
+
+
+ANSWER_DRAFT_OUTPUT = {
+    "type": "object",
+    "required": ["answer", "word_count", "stories_used", "evidence_used", "fill_ins", "gaps",
+                 "honesty_check"],
+    "properties": {
+        "answer": {"type": "string",
+                   "description": "First person, as spoken. Plain text, paragraphs split by a blank line"},
+        "word_count": {"type": "integer"},
+        "stories_used": {"type": "array", "items": {"type": "integer"},
+                         "description": "ids from candidate.story_bank that the answer relies on"},
+        "evidence_used": {**_STRINGS, "description": "Profile items or story titles relied on"},
+        "fill_ins": {
+            "type": "array",
+            "description": "Every [FILL IN: ...] marker left in the answer",
+            "items": {"type": "object", "required": ["marker", "needed"],
+                      "properties": {"marker": {"type": "string", "description": "Exact text in the answer"},
+                                     "needed": {"type": "string", "description": "What the candidate must supply, and only if true"}}},
+        },
+        "gaps": {**_STRINGS, "description": "What the question asks for that the profile and stories do not show"},
+        "honesty_check": {"type": "string", "description": "One or two sentences: what in the answer is "
+                                                          "stated fact and where it comes from"},
+    },
+}
+
+ANSWER_DRAFT_SYSTEM = f"""\
+You write the answer a candidate would say aloud to one interview question.
+You have no tools. The candidate reviews and rehearses it, so it must be something
+they can truthfully stand behind.
+
+Facts: only the candidate profile, including candidate.story_bank when present (examples
+the candidate wrote about their own work). If story_ids are given, build on those; if not,
+choose the one or two stories that fit best. Ids in stories_used must come from the bank.
+
+Shape: answer the question directly in the first sentence, then one concrete example in
+situation, task, action, result order, and finish on the result and what it shows. First
+person, plain spoken English, no lists. Aim for about 130 words per minute of the
+requested speaking time.
+
+Missing detail: where a number, outcome, tool, client or timeframe would make the answer
+stronger but is not in the profile or story, do NOT supply one. Put a visible marker in
+the text, exactly like [FILL IN: the real load time before and after], and list every
+marker in fill_ins. An answer with honest markers is better than a confident invention.
+
+If current_answer is given, keep the candidate's wording and every fact in it; improve
+order and clarity only, and add no new claim. If answer_outline is given, treat it as a
+guide, not as a source of facts.
+
+If nothing in the profile or stories answers the question, say so in gaps and write a
+short, candid answer from the nearest real experience. Never bluff a skill the profile
+does not show (for example a language or framework it does not list).
+
+{_RULES}"""
+
+
+def _build_answer_prompt(data: AnswerDraftInput) -> str:
+    lines = ["Write a spoken answer to this interview question."] + _role_block(data.role) + [""]
+    lines += _candidate_block(data)
+    lines += ["", f"Question: {data.question.strip()}"]
+    if data.why_asked.strip():
+        lines.append(f"What the interviewer is probing: {data.why_asked.strip()}")
+    if data.answer_outline.strip():
+        lines.append(f"Earlier outline (a guide only): {data.answer_outline.strip()}")
+    if data.story_ids:
+        lines.append("Build on these story_bank ids: " + ", ".join(str(i) for i in data.story_ids))
+    if data.current_answer.strip():
+        lines += ["", "The candidate's own draft (keep their wording and facts):",
+                  json.dumps(data.current_answer.strip(), ensure_ascii=False)]
+    lines.append(f"\nTarget speaking time: {data.spoken_minutes} minute(s).")
+    return "\n".join(lines + _tail(data))
+
+
